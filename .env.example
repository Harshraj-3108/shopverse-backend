# ╔══════════════════════════════════════════════════════════════════╗
# ║         ShopVerse Backend – Environment Configuration           ║
# ║         Copy this file to backend/.env and fill in your values  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/shopverse

# ─── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Security ─────────────────────────────────────────────────────────────
# Use a minimum 32-character random string for each secret
JWT_SECRET=your_jwt_access_secret_at_least_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars_here

# ─── CORS (Production only) ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty in development (localhost variants are auto-allowed).
CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── Image Storage (ImageKit) ─────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# ─── Payment (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
