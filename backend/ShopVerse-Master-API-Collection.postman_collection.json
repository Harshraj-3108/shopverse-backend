          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Customer User Updated\",\n  \"phone\": \"+919999988888\"\n}" }
          }
        },
        {
          "name": "Get Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/addresses", "host": ["{{baseUrl}}"], "path": ["users", "addresses"] }
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/addresses", "host": ["{{baseUrl}}"], "path": ["users", "addresses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"street\": \"123 Tech Park Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"zipCode\": \"400001\",\n  \"country\": \"India\",\n  \"isDefault\": true\n}"
            }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/users/addresses/{{addressId}}", "host": ["{{baseUrl}}"], "path": ["users", "addresses", "{{addressId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"street\": \"456 Innovation Way\"\n}" }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/addresses/{{addressId}}", "host": ["{{baseUrl}}"], "path": ["users", "addresses", "{{addressId}}"] }
          }
        }
      ]
    },
    {
      "name": "03. Categories",
      "item": [
        {
          "name": "Get All Categories (Flat)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Get Categories (Tree Format)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories?format=tree", "host": ["{{baseUrl}}"], "path": ["categories"], "query": [{ "key": "format", "value": "tree" }] }
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories/electronics", "host": ["{{baseUrl}}"], "path": ["categories", "electronics"] }
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smartphones\",\n  \"description\": \"Mobile phones and accessories\"\n}" }
          }
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/categories/categoryIdHere", "host": ["{{baseUrl}}"], "path": ["categories", "categoryIdHere"] },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated smartphones category description\"\n}" }
          }
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/categories/categoryIdHere", "host": ["{{baseUrl}}"], "path": ["categories", "categoryIdHere"] }
          }
        }
      ]
    },
    {
      "name": "04. Products",
      "item": [
        {
          "name": "List Products (Filter, Search, Paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&sort=newest&search=headphone",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "newest" },
                { "key": "search", "value": "headphone" }
              ]
            }
          }
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/slug/{{productSlug}}", "host": ["{{baseUrl}}"], "path": ["products", "slug", "{{productSlug}}"] }
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones Pro\",\n  \"sku\": \"WH-PRO-001\",\n  \"description\": \"High fidelity active noise cancelling headphones\",\n  \"price\": 4999,\n  \"salePrice\": 3999,\n  \"stockQuantity\": 50,\n  \"categoryId\": \"categoryIdHere\"\n}"
            }
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"stockQuantity\": 60\n}" }
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        }
      ]
    },
