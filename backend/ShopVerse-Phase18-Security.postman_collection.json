{
  "info": {
    "_postman_id": "phase18-security-hardening",
    "name": "ShopVerse – Phase 18: Security Hardening",
    "description": "Security testing collection for Phase 18. Tests Helmet headers, CORS, rate limiting, XSS/NoSQL injection protection, HPP, and authentication security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🛡️ Security Headers (Helmet)",
      "item": [
        {
          "name": "Verify Security Headers Present",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('X-Content-Type-Options: nosniff present', () => {",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "pm.test('X-Frame-Options: DENY present', () => {",
                  "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "});",
                  "pm.test('Content-Security-Policy header present', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string');",
                  "});",
                  "pm.test('X-Powered-By header NOT present', () => {",
                  "  pm.expect(pm.response.headers.get('X-Powered-By')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?page=1&limit=1", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "1" }] },
            "description": "Verify Helmet security headers are present in API responses. Run the tests tab to see pass/fail."
          }
        },
        {
          "name": "Health Check – Verify Headers",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/health", "host": ["http://localhost:5000"], "path": ["health"] },
            "description": "Check Helmet headers on the health endpoint. Check response headers panel."
          }
        }
      ]
    },
    {
      "name": "🚫 NoSQL Injection Protection",
      "item": [
        {
          "name": "NoSQL Injection via Login (Blocked)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": { \"$gt\": \"\" },\n  \"password\": { \"$gt\": \"\" }\n}"
            },
            "description": "Attempt MongoDB operator injection. Should be sanitized by express-mongo-sanitize. The $gt key will be replaced with _gt, failing validation. Expected: 400 or 401 (not 200 bypass)."
          }
        },
        {
          "name": "NoSQL Injection via Query Param (Blocked)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?categoryId[$gt]=",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "categoryId[$gt]", "value": "" }]
            },
            "description": "Attempt injection via query parameter. Mongo sanitizer replaces $ keys. Expected: 400 validation error or empty results (not MongoDB error)."
          }
        }
      ]
    },
    {
      "name": "🔒 XSS Protection",
      "item": [
        {
          "name": "XSS via Signup Name (Sanitized)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<script>alert('xss')</script>\",\n  \"email\": \"xss-test@example.com\",\n  \"password\": \"TestPass123\"\n}"
            },
            "description": "Script tag in name field should be escaped before storage. Check the response – the name should be escaped HTML, not the raw script tag."
          }
        },
        {
          "name": "XSS via Search Query (Sanitized)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=<script>alert(1)</script>",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "search", "value": "<script>alert(1)</script>" }]
            },
            "description": "XSS via query parameter. The search value should be escaped in the response. No script execution should occur."
          }
        }
      ]
    },
    {
      "name": "🔁 HTTP Parameter Pollution (HPP)",
      "item": [
        {
          "name": "Duplicate Sort Parameter (HPP Blocked)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?sort=newest&sort=__proto__&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "sort", "value": "newest" },
                { "key": "sort", "value": "__proto__" },
                { "key": "page", "value": "1" }
              ]
            },
            "description": "HPP attack: submit duplicate query params. hpp middleware keeps only the last value. Expected: 200 with normal results (last value used), not an array causing type errors."
          }
        },
        {
          "name": "Duplicate Page Parameter (HPP Blocked)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&page=999&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page", "value": "999" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Duplicate page parameter. HPP keeps last value (999). Should return empty results but not crash."
          }
        }
      ]
    },
    {
      "name": "⏱️ Rate Limiting Tests",
      "item": [
        {
          "name": "Auth Rate Limit – Trigger 429 (Run 11+ times)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent@test.com\",\n  \"password\": \"wrongpass\"\n}"
            },
            "description": "Run this 11+ times rapidly. After 10 attempts in 15 min → 429 with 'Too many authentication attempts' message and RateLimit-* headers."
          }
        },
        {
          "name": "Check Rate Limit Response Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RateLimit headers present', () => {",
                  "  pm.expect(pm.response.headers.get('RateLimit-Limit')).to.be.a('string');",
                  "  pm.expect(pm.response.headers.get('RateLimit-Remaining')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?page=1&limit=1", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "1" }] },
            "description": "Check that RateLimit-Limit and RateLimit-Remaining headers are present in every API response."
          }
        }
      ]
    },
    {
      "name": "🔑 Authentication Security",
      "item": [
        {
          "name": "Access Protected Route Without Token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "description": "Access protected endpoint without Authorization header. Expected: 401 Unauthorized."
          }
        },
        {
          "name": "Access Protected Route With Invalid Token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.jwt.token" }],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] },
            "description": "Tampered JWT. Expected: 401 Unauthorized – 'Not authorized to access this resource'."
          }
        },
        {
          "name": "Access Admin Route as Customer (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/cache/stats", "host": ["{{baseUrl}}"], "path": ["admin", "cache", "stats"] },
            "description": "Customer token on admin endpoint. Expected: 403 Forbidden – 'User does not have access permissions'."
          }
        },
        {
          "name": "Access Another User's Order (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/000000000000000000000001", "host": ["{{baseUrl}}"], "path": ["orders", "000000000000000000000001"] },
            "description": "Attempt to access another user's order. Expected: 403 Forbidden or 404 Not Found."
          }
        },
        {
          "name": "Refresh Token Without Cookie (401)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] },
            "description": "Refresh endpoint with no cookie. Expected: 401 – 'Refresh token is required'."
          }
        }
      ]
    },
    {
      "name": "📋 CORS Tests",
      "item": [
        {
          "name": "Allowed Origin (Localhost Dev)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Origin", "value": "http://localhost:3000" }],
            "url": { "raw": "{{baseUrl}}/products?page=1&limit=1", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "1" }] },
            "description": "Request from localhost:3000. Expected: Access-Control-Allow-Origin: http://localhost:3000 in response headers."
          }
        },
        {
          "name": "OPTIONS Preflight Request",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:3000" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "Content-Type, Authorization" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "CORS preflight request. Expected: 200 with Access-Control-Allow-Methods and Access-Control-Allow-Headers."
          }
        }
      ]
    },
    {
      "name": "📚 API Documentation",
      "item": [
        {
          "name": "Swagger UI (Dev only)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/v1/docs", "host": ["http://localhost:5000"], "path": ["api", "v1", "docs"] },
            "description": "Open Swagger UI interactive documentation. Only available in development mode (NODE_ENV=development)."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/health", "host": ["http://localhost:5000"], "path": ["health"] },
            "description": "Application health check. Returns status, uptime, timestamp, and environment."
          }
        }
      ]
    },
    {
      "name": "🔍 Validation Tests",
      "item": [
        {
          "name": "Login – Missing Fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "Empty body to login. Expected: 400 with Zod validation details listing missing email and password."
          }
        },
        {
          "name": "Signup – Invalid Email (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"pass\"\n}"
            },
            "description": "Invalid email format and short password. Expected: 400 with multiple validation error details."
          }
        },
        {
          "name": "Create Product – Missing Required Fields (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "body": { "mode": "raw", "raw": "{ \"name\": \"Test\" }" },
            "description": "Admin creates product with missing required fields. Expected: 400 validation error listing missing fields."
          }
        }
      ]
    }
  ]
}
