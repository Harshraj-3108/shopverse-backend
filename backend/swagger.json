        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order details retrieved" },
          "403": { "description": "Forbidden – not your order" },
          "404": { "description": "Order not found" }
        }
      }
    },

    "/orders/{id}/timeline": {
      "get": {
        "summary": "Get the full status timeline of an order (Customer – ownership checked)",
