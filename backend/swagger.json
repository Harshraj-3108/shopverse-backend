                  "trackingUrl": { "type": "string", "format": "uri", "example": "https://bluedart.com/track/TRK123456789" },
                  "estimatedDelivery": { "type": "string", "format": "date-time", "example": "2025-08-05T18:00:00.000Z" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Shipping information updated" },
          "400": { "description": "Cannot add tracking to pending/cancelled orders" },
          "404": { "description": "Order not found" }
        }
      }
    },

    "/orders/admin/{id}/delivery-timeline": {
      "patch": {
        "summary": "Admin – Update estimated delivery date",
        "tags": ["Orders – Admin"],
